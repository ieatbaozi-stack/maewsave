# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth & Single-User Lock ---
BETTER_AUTH_SECRET="generate-a-32-byte-random-base64-string"
BETTER_AUTH_URL="http://localhost:3000"
ALLOWED_USER_EMAIL="your-personal-email@gmail.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Optional: Passkey / Face ID (WebAuthn) ---
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- AI Engine (Gemini Pay-as-you-go API for Zero Data Training) ---
GEMINI_API_KEY=""

# --- Vercel Cron Job Security ---
CRON_SECRET="generate-a-32-byte-random-hex-string"

# --- iOS PWA Web Push Notifications (VAPID Keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-personal-email@gmail.com"

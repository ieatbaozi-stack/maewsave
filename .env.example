# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ---
BETTER_AUTH_SECRET="generate-a-32-byte-random-base64-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth 2.0 (openid, email, profile) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email Transport Layer (dev/test: "log" | production: "smtp") ---
EMAIL_TRANSPORT="log"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="mailbox@example.com"
SMTP_PASS=""
SMTP_FROM="maewsave <mailbox@example.com>"

# --- OTP Global Daily Cap & Session Lifetime ---
OTP_DAILY_CAP="400"
SESSION_MAX_AGE_DAYS="30"

# --- Vercel Cron Job Security (Auth Cleanup + Recurring Rules) ---
CRON_SECRET="generate-a-32-byte-random-hex-string"

# --- Optional: Passkey / Face ID (WebAuthn) ---
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- AI Engine (Gemini Pay-as-you-go API for Zero Data Training) ---
GEMINI_API_KEY=""

# --- iOS PWA Web Push Notifications (VAPID Keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"
